{
    "name": "brianjdevries.com",
    "version": "2.0.0",
    "description": "Brian DeVries's personal website",
    "main": ".eleventy.js",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "serve": "ELEVENTY_ENV=development eleventy --serve --quiet",
        "test": "ELEVENTY_ENV=development eleventy --quiet",
        "build": "ELEVENTY_ENV=production eleventy && npm run create-search-index",
        "create-search-index": "npx pagefind --site dist",
        "new-post": "node ./setup-scripts/new-post.js"
    },
    "keywords": [
        "eleventy",
        "ssg",
        "static-site-generator"
    ],
    "author": "Brian DeVries",
    "license": "MIT",
    "devDependencies": {
        "@11ty/eleventy": "^3.1.7",
        "@11ty/eleventy-img": "^7.0.0",
        "@11ty/eleventy-navigation": "^0.1.6",
        "@11ty/eleventy-plugin-rss": "^1.2.0",
        "@11ty/eleventy-plugin-syntaxhighlight": "^3.2.2",
        "dayjs": "^1.11.5",
        "html-validate": "^7.5.0",
        "kleur": "^4.1.5",
        "markdown-it": "^15.0.3",
        "pagefind": "^1.0.3",
        "slugify": "^1.6.9"
    }
}
